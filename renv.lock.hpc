      "NeedsCompilation": "yes",
      "Author": "Winston Chang [aut, cre], Posit Software, PBC [cph, fnd], Tessil [cph] (hopscotch_map library)",
      "Maintainer": "Winston Chang <winston@posit.co>",
      "Repository": "CRAN"
    },
